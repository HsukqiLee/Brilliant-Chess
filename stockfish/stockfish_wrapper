#!/bin/bash
engine_path="$1"

# Inject performance tuning parameters if set
(
  if [ -n "$STOCKFISH_THREADS" ]; then
    echo "setoption name Threads value $STOCKFISH_THREADS"
  fi
  if [ -n "$STOCKFISH_HASH" ]; then
    echo "setoption name Hash value $STOCKFISH_HASH"
  fi
  
  # Read line-by-line from socket stdin and forward immediately
  while read -r line; do
    echo "$line"
  done
) | "$engine_path"
